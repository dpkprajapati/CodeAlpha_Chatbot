def get_bot_response(user_input):
    # Convert input to lowercase so it's not case-sensitive (e.g., "Hello" vs "hello")
    cleaned_input = user_input.lower().strip()
    
    # Simple rule-based responses
    if cleaned_input in ["hi", "hello", "hey"]:
        return "Hi there! How can I help you today?"
    elif cleaned_input in ["how are you", "how are you doing"]:
        return "I'm doing great, thanks for asking! How about you?"
    elif cleaned_input in ["what is your name", "who are you"]:
        return "I'm a simple rule-built chatbot, nice to meet you!"
    elif cleaned_input in ["bye", "goodbye", "exit"]:
        return "Goodbye! Have a wonderful day!"
    else:
        return "Hmm, I'm not quite sure how to respond to that. Try saying 'hello' or 'how are you'!"

def run_chatbot():
    print("🤖 Chatbot: Hello! Type something to chat with me (type 'bye' to exit).\n")
    
    while True:
        # Get input from the user
        user_message = input("You: ")
        
        # Check if the user wants to quit
        if user_message.lower().strip() in ["bye", "goodbye", "exit"]:
            print(f"🤖 Chatbot: {get_bot_response(user_message)}")
            break
            
        # Get and print the bot's response
        response = get_bot_response(user_message)
        print(f"🤖 Chatbot: {response}\n")

# Run the chatbot
if __name__ == "__main__":
    run_chatbot()
